# ==============================
# Core
# ==============================
COMPOSE_PROJECT_NAME=dadpt
TZ=Asia/Ho_Chi_Minh

# ==============================
# Domains
# ==============================
API_DOMAIN=api.example.com
AI_DOMAIN=ai.example.com

# ==============================
# Image tags (GHCR)
# ==============================
BACKEND_IMAGE=ghcr.io/your-org/dadpt-backend:latest
AISERVICE_IMAGE=ghcr.io/your-org/dadpt-aiservice:latest

# ==============================
# Backend
# ==============================
ENVIRONMENT=production
HTTP_PORT=8080
BOOKING_EXPIRY_DURATION=10m

DATABASE_USER=postgres
DATABASE_PASSWORD=change_me_strong
DATABASE_NAME=bus_ticketing_db
DATABASE_URI=postgres://postgres:change_me_strong@postgres:5432/bus_ticketing_db?sslmode=disable

REDIS_URI=redis://redis:6379
REDIS_PASSWORD=change_me_redis
REDIS_DB=0

RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=change_me_rabbit
RABBITMQ_VHOST=/
RABBITMQ_URI=amqp://rabbitmq:change_me_rabbit@rabbitmq:5672/

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=bus-ticketing
MINIO_BASE_URL=https://api.example.com
MINIO_USE_SSL=false

AUTH_SECRET=change_me_jwt_secret_long_random
ACCESS_TOKEN_DURATION=168h
REFRESH_TOKEN_DURATION=720h

AI_AGENT_GRPC_ADDR=aiservice:50051

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://your-frontend-domain/payment/success
PAYOS_CANCEL_URL=https://your-frontend-domain/payment/cancel

# ==============================
# AI Service
# ==============================
AI_SERVICE_PORT=8100
GRPC_PORT=50051

OPENAI_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACEHUB_API_TOKEN=

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

ADMIN_DB_PATH=/app/data/admin.db
ENCRYPTION_KEY=change_me_32_bytes_or_fernet_key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DEFAULT_GRPC_TARGET=backend:50052

# ==============================
# Nginx SSL (Cloudflare Origin Cert)
# ==============================
NGINX_SSL_CERT_PATH=/etc/nginx/certs/origin.pem
NGINX_SSL_KEY_PATH=/etc/nginx/certs/origin.key
