# === AI Agent Platform ===
ENVIRONMENT=development
AI_SERVICE_PORT=8100
GRPC_PORT=50051

# === LLM API Keys (Global — referenced by model_providers table) ===
OPENAI_API_KEY=sk-your-openai-key
GOOGLE_API_KEY=your-google-ai-key

# === Qdrant ===
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# === Redis (separate from Go backend — port 6380) ===
REDIS_URI=redis://localhost:6380
REDIS_PASSWORD=redis123
REDIS_DB=1

# === Admin DB ===
ADMIN_DB_PATH=./data/admin.db

# === Encryption (for API keys in DB — Phase 2) ===
ENCRYPTION_KEY=

# === Embedding ===
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# === Go Backend gRPC target (default for bus tenant) ===
DEFAULT_GRPC_TARGET=localhost:50052

# === Logging ===
LOG_LEVEL=DEBUG
